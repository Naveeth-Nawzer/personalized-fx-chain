{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "M1 Audio Features Contract",
  "type": "object",
  "required": [
    "audio_id",
    "source",
    "peak_dbFS",
    "rms_dbFS",
    "crest_factor_db",
    "zero_crossing_rate",
    "spectral_centroid_hz",
    "spectral_bandwidth_hz",
    "spectral_rolloff_85pct_hz",
    "spectral_flatness",
    "low_sub_bass_under_250hz_pct",
    "midrange_250_to_4000hz_pct",
    "high_presence_above_4000hz_pct"
  ],
  "properties": {
    "audio_id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": ["dry", "reference", "generated"]
    },
    "peak_dbFS": {
      "type": "number"
    },
    "rms_dbFS": {
      "type": "number"
    },
    "crest_factor_db": {
      "type": "number"
    },
    "zero_crossing_rate": {
      "type": "number"
    },
    "spectral_centroid_hz": {
      "type": "number"
    },
    "spectral_bandwidth_hz": {
      "type": "number"
    },
    "spectral_rolloff_85pct_hz": {
      "type": "number"
    },
    "spectral_flatness": {
      "type": "number"
    },
    "low_sub_bass_under_250hz_pct": {
      "type": "number"
    },
    "midrange_250_to_4000hz_pct": {
      "type": "number"
    },
    "high_presence_above_4000hz_pct": {
      "type": "number"
    }
  }
}
