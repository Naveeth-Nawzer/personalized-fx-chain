{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PTA → M3 Guidance Message",
  "type": "object",
  "required": [
    "schema_version",
    "user_id",
    "session_id",
    "sample_id",
    "event_type",
    "action",
    "reward",
    "z_taste",
    "constraints"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "user_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "sample_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": ["PREFERENCE_UPDATED", "SESSION_SATISFIED"]
    },
    "feedback_command": {
      "type": "string"
    },
    "changed_dimensions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reward": {
      "type": "object",
      "required": ["r_pta", "confidence"],
      "properties": {
        "r_pta": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "explanation": {
          "type": "string"
        }
      }
    },
    "z_taste": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "number",
        "minimum": -1.0,
        "maximum": 1.0
      }
    },
    "constraints": {
      "type": "object",
      "required": ["prohibited_effects", "parameter_bounds"],
      "properties": {
        "prohibited_effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parameter_bounds": {
          "type": "object"
        }
      }
    },
    "action": {
      "type": "string",
      "enum": ["REGENERATE", "NONE"]
    }
  }
}
