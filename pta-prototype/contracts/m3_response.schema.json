{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "M3 → PTA Acknowledgment Response Contract",
  "type": "object",
  "required": ["status"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ACKNOWLEDGED", "SESSION_CLOSED"]
    },
    "action": {
      "type": "string",
      "enum": ["REGENERATE", "NONE"]
    },
    "z_taste_dims": {
      "type": "integer"
    },
    "r_pta": {
      "type": "number",
      "minimum": -1.0,
      "maximum": 1.0
    },
    "constraint_effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "final_sample_id": {
      "type": "string"
    }
  }
}
